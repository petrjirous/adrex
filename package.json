{
  "name": "adrex",
  "version": "0.1.0",
  "description": "Self-hosted Czech address autocomplete powered by RÚIAN open data",
  "license": "MIT",
  "keywords": ["address", "autocomplete", "czech", "ruian", "meilisearch", "widget"],
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/petrjirous/adrex.git"
  },
  "homepage": "https://github.com/petrjirous/adrex#readme",
  "bugs": {
    "url": "https://github.com/petrjirous/adrex/issues"
  },
  "author": "",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts src/pipeline.ts --format esm --dts",
    "start": "node dist/server.js",
    "pipeline": "tsx src/pipeline.ts",
    "pipeline:download": "tsx src/pipeline.ts --download-only",
    "pipeline:index": "tsx src/pipeline.ts --index-only",
    "typecheck": "tsc --noEmit",
    "widget:dev": "cd widget && npm run dev",
    "widget:build": "cd widget && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "meilisearch": "^0.44.0",
    "csv-parse": "^5.6.0",
    "proj4": "^2.12.0",
    "dotenv": "^16.4.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proj4": "^2.5.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
